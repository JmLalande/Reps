  {
   "id": "effort",
   "title": "How should a set's effort be logged?",
   "default": "three",
   "options": [
    {
     "value": "keep",
     "label": "0 · 1 · 2 · 3 · 4+",
     "desc": "What you have now, after every set."
    },
    {
     "value": "four",
     "label": "0 · 1 · 2 · 3+",
     "desc": "Your idea. Still asks 1 vs 2, inside the guessing error."
    },
    {
     "value": "three",
     "label": "Failed · On target · Easy",
     "desc": "Preset on target, so most sets need no tap. Holds skip it. Plus one 1–10 rating for the day.",
     "rec": true
    },
    {
     "value": "last",
     "label": "Last set only",
     "desc": "The same three taps once per exercise, plus the day rating. You lose the set-by-set fade."
    }
   ],
   "why": [
    {
     "stat": "±1 rep",
     "text": "How far off people are when guessing reps left. Worse far from failure and above 12 reps.",
     "cite": "Halperin 2022",
     "url": "https://pubmed.ncbi.nlm.nih.gov/34542869/"
    },
    {
     "stat": "44%",
     "text": "of your logged sets say 4+, the least reliable answer.",
     "cite": "your export"
    },
    {
     "stat": "near vs far",
     "text": "Growth tracks how close to failure, not the exact number.",
     "cite": "Robinson 2024",
     "url": "https://pubmed.ncbi.nlm.nih.gov/38970765/"
    },
    {
     "stat": "1–10",
     "text": "One rating for the whole session captures a mentally hard day.",
     "cite": "Haddad 2017",
     "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC5673663/"
    }
   ]
  }
 ],
